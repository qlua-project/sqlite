 # resize the Surface and set a 2d transformation to confine the viewbox 
 # within the Surface (leaving a 'frame' of m pixel )
 #  .. 
 #  W, H the size of the Surface container (in pixel)
 #  m  margin (in pixel)
 #  viewBox   (x y dx dy)  in world coords
 #
proc Resize {SFC W H m viewBox } {
	if { $W <= 2*$m || $H <= 2*$m }  return

	lassign $viewBox x0 y0 dx dy
	set dx [expr {double($dx)}]
	set dy [expr {double($dy)}]
	
	set ratio [expr {$dx/$dy}]

	 # pay attention: ratio of two integers ..
	if { double(($W-2*$m))/($H-2*$m) > $ratio } {
		set DY $H
			set DY1 [expr {$DY-2*$m}]
			set DX1 [expr {round($DY1*$ratio)}]
		set DX [expr {$DX1+2*$m}]
	} else {
		set DX $W
			set DX1 [expr {$DX-2*$m}]
			set DY1 [expr {round($DX1/$ratio)}]
		set DY [expr {$DY1+2*$m}]	
	}
	 # note that DX1/DY1 is equal to ratio
	set zoom [expr {$DX1/$dx}]  ; # same as DY1/dy

	 # DX DY is the required size of SFC
	 lassign [$SFC size] oldDX oldDY
	 if { $DX != $oldDX || $DY != $oldDY } {
	 	$SFC configure -format [list $DX $DY]
	 }
	 
	 # scale/traslate the SFC's coord-system
	set M [Mtx::MxM \
			[Mtx::scale $zoom] \
			[Mtx::translation $m $m] \
		]	
	$SFC configure -matrix $M
}

proc Redraw {SFC pathsAndColors filterType shadowAngle} {
	$SFC clear -style [BL::color white]
	$SFC configure -fill.rule EVEN_ODD
	
	set r 10
	set dxy [list [expr {round($r*cos($shadowAngle))}] [expr {round($r*sin($shadowAngle))}]]
	foreach {blPath color} $pathsAndColors {
		$SFC filter $filterType -radius 20 -dxy $dxy -color [BL::color gray20] {
			$SFC fill $blPath -style [BL::color $color]
		}
	}
}  

 # == MAIN =====
wm title . "TclTk bindings for Blen2d - demo 112"

set FILTER_TYPE "ignore"
set MARGIN 30


frame .leftBar
	ttk::checkbutton .leftBar.shadow -text "Shadows" -variable FILTER_TYPE \
		-offvalue "ignore" -onvalue "shadow"

	ttk::label .leftBar.msg -text \
"Enable the shadows
 and click on the picture
 to change the shadow direction"
	pack .leftBar.msg .leftBar.shadow 
	pack .leftBar.shadow -padx 5 -side left

pack .leftBar -padx 5 -side left

set SFC [image create blend2d]
label .cvs -image $SFC -borderwidth 0
pack .cvs -padx 20 -pady 20 -expand 1 -fill both

# ---

set PathsAndColors {}
foreach layer $SVGlayers color $SVGcolors {
	set blPath [BL::Path new]
    $blPath addSVGpath $layer
	lappend PathsAndColors $blPath $color
}

set ShadowAngle [expr {-30*3.1415/180}]   ;# -30 degrees (in radians)
# compute viewbox  ( from the 1st layer ) ...
set bbox [[lindex $PathsAndColors 0 0] bbox]
 # transform bbox from a rectangle to a box
lassign $bbox x0 y0 x1 y1
set viewBox [list $x0 $y0 [expr {$x1-$x0}] [expr {$y1-$y0}]]

Resize $SFC 500 500 $MARGIN $viewBox
Redraw $SFC $PathsAndColors $FILTER_TYPE $ShadowAngle

 # resize and redraw
bind .cvs <Configure> { 
	Resize $SFC %w %h $MARGIN $viewBox 
	Redraw $SFC $PathsAndColors $FILTER_TYPE $ShadowAngle
}     

 # turn the shadow on/off     
.leftBar.shadow configure -command { Redraw $SFC $PathsAndColors $FILTER_TYPE $ShadowAngle}  

 # change the shadow angle
bind .cvs <ButtonPress-1> {
	# get the angle .. consider the center of the image as the origin ..
	lassign [$SFC size] width height
	set ShadowAngle [expr {atan2(%y-$height/2,%x-$width/2)}]		
	Redraw $SFC $PathsAndColors $FILTER_TYPE $ShadowAngle	
}      