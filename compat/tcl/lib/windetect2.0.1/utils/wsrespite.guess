#! /bin/sh
# If executed as a shell script, the next line replaces the shell \
exec tclsh "$0" ${1+"$@"}

#
# Estimates a useful value for the option -wsrespite, based on latency
# values exhibited by the windetect gui-integration tests that involve
# the window manager (i.e. toplevel crossings).
#

#
# Copyright 2020 Erik Leunissen
#
